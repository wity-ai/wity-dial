{
  "name": "@wity.ai/dial",
  "version": "0.1.0",
  "description": "DIAL protocol — JS layer over dial-core WASM. Exposes parse, DialSession, and DialRouter.",
  "type": "module",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs",
      "types": "./index.d.ts"
    }
  },
  "keywords": ["dial", "protocol", "parser", "router", "wasm", "wity"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wity-ai/wity-dial.git",
    "directory": "packages/dial"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dial-core-wasm": "file:../dial-core-wasm/pkg-node"
  },
  "bundleDependencies": ["dial-core-wasm"]
}
