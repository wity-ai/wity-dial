# Route @wity scoped packages to GitHub Packages registry
@wity:registry=https://npm.pkg.github.com

# Auth token — set via environment variable (never hardcode here)
# Either:
#   export NPM_TOKEN=ghp_...
#   (or set in ~/.npmrc: //npm.pkg.github.com/:_authToken=ghp_...)
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
